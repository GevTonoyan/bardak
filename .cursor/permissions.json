{
  "terminalAllowlist": [
    "flutter pub get",
    "flutter pub upgrade",
    "flutter pub outdated",
    "flutter analyze",
    "flutter test",
    "flutter test --coverage",
    "flutter format .",
    "flutter format lib",
    "flutter build apk",
    "flutter build ios",
    "flutter build appbundle",
    "flutter run",
    "flutter clean",
    "flutter pub run build_runner build --delete-conflicting-outputs",
    "flutter gen-l10n",
    "dart format .",
    "dart format lib",
    "dart analyze",
    "dart test",
    "dart run build_runner build --delete-conflicting-outputs",
    "dart run build_runner watch --delete-conflicting-outputs",
    "dart pub get",
    "dart pub upgrade"
  ],
  "autoRun": {
    "allow_instructions": [
      "Allow all flutter and dart CLI commands for this project",
      "Allow build_runner code generation commands",
      "Allow flutter gen-l10n for localisation generation",
      "Allow flutter analyze and dart analyze to check code quality",
      "Allow flutter test and dart test to run the test suite",
      "Allow flutter format and dart format to format Dart files"
    ]
  }
}
