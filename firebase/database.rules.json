{
  "rules": {
    ".read": false,
    ".write": false,
    "sea_battle_rooms": {
      "$code": {
        ".read": "auth != null && (data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid && newData.child('status').val() === 'waiting') || (!newData.exists() && (data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid)))",
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{6}$/) && newData.hasChildren(['host', 'status', 'createdAt'])",
        "host": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "guest": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && newData.val() !== root.child('sea_battle_rooms').child($code).child('host').val() && root.child('sea_battle_rooms').child($code).child('status').val() === 'waiting'",
          ".validate": "newData.isString()"
        },
        "status": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('sea_battle_rooms').child($code).child('host').val() === auth.uid || root.child('sea_battle_rooms').child($code).child('guest').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().matches(/^(waiting|placing|battle|finished)$/)"
        },
        "createdAt": {
          ".read": "auth != null",
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "turn": {
          ".write": "auth != null && (root.child('sea_battle_rooms').child($code).child('host').val() === auth.uid || root.child('sea_battle_rooms').child($code).child('guest').val() === auth.uid)",
          ".validate": "newData.val() === root.child('sea_battle_rooms').child($code).child('host').val() || newData.val() === root.child('sea_battle_rooms').child($code).child('guest').val()"
        },
        "ready": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && (root.child('sea_battle_rooms').child($code).child('host').val() === auth.uid || root.child('sea_battle_rooms').child($code).child('guest').val() === auth.uid)",
            ".validate": "newData.isBoolean()"
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && (root.child('sea_battle_rooms').child($code).child('host').val() === auth.uid || root.child('sea_battle_rooms').child($code).child('guest').val() === auth.uid)",
            ".validate": "newData.isBoolean()"
          }
        },
        "rematch": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && (root.child('sea_battle_rooms').child($code).child('host').val() === auth.uid || root.child('sea_battle_rooms').child($code).child('guest').val() === auth.uid)",
            ".validate": "newData.isBoolean()"
          }
        },
        "shots": {
          "$index": {
            ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid && root.child('sea_battle_rooms').child($code).child('turn').val() === auth.uid && root.child('sea_battle_rooms').child($code).child('status').val() === 'battle'",
            ".validate": "newData.hasChildren(['by', 'row', 'column'])",
            "by": {
              ".validate": "newData.val() === data.val() || !data.exists()"
            },
            "row": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9 && (newData.val() === data.val() || !data.exists())"
            },
            "column": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9 && (newData.val() === data.val() || !data.exists())"
            },
            "result": {
              ".write": "auth != null && !data.exists() && data.parent().child('by').val() !== auth.uid && (root.child('sea_battle_rooms').child($code).child('host').val() === auth.uid || root.child('sea_battle_rooms').child($code).child('guest').val() === auth.uid)",
              ".validate": "newData.isString() && newData.val().matches(/^(miss|hit|sunk)$/)"
            },
            "sunkShip": {
              ".write": "auth != null && !data.exists() && data.parent().child('by').val() !== auth.uid && (root.child('sea_battle_rooms').child($code).child('host').val() === auth.uid || root.child('sea_battle_rooms').child($code).child('guest').val() === auth.uid)",
              ".validate": "newData.hasChildren(['row', 'column', 'length', 'orientation'])"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "fleets": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && !data.exists() && root.child('sea_battle_rooms').child($code).child('status').val() === 'finished' && (root.child('sea_battle_rooms').child($code).child('host').val() === auth.uid || root.child('sea_battle_rooms').child($code).child('guest').val() === auth.uid)"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
