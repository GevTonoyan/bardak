default_platform(:ios)

# Fastfile code runs from ios/fastlane, so resolve paths explicitly.
PROJECT_ROOT = File.expand_path("../..", __dir__)
XCODE_PROJECT = File.join(PROJECT_ROOT, "ios/Runner.xcodeproj")
EXPORT_OPTIONS = File.join(PROJECT_ROOT, "ios/ExportOptions.plist")
IPA_DIR = File.join(PROJECT_ROOT, "build/ios/ipa")
APP_ID = "com.gevorgtonoyan.bardak"
PROFILE_NAME = "match AppStore #{APP_ID}"

# App Store version states after approval. Apple closes a version's "train"
# once it reaches one of these and rejects further builds with that version.
CLOSED_VERSION_STATES = [
  "ACCEPTED",
  "PENDING_APPLE_RELEASE",
  "PENDING_DEVELOPER_RELEASE",
  "PROCESSING_FOR_DISTRIBUTION",
  "READY_FOR_DISTRIBUTION",
  "REPLACED_WITH_NEW_VERSION",
].freeze
BUMPS = ["auto", "minor", "major"].freeze

# Appends Markdown to the GitHub Actions run summary; does nothing locally.
def write_ci_summary(markdown)
  path = ENV["GITHUB_STEP_SUMMARY"]
  File.write(path, "#{markdown}\n\n", mode: "a") if path
end

def required_env(name)
  value = ENV[name]
  return value unless value.to_s.empty?

  UI.user_error!(
    "Environment variable #{name} is not set. Locally, export it in " \
    "~/.zshrc and open a new terminal; on CI, add it as a secret.",
  )
end

# "2.1.3" with part "patch" → "2.1.4", "minor" → "2.2.0", "major" → "3.0.0".
# A short version such as "2.1" counts as "2.1.0".
def bump_version(version, part)
  major, minor, patch = (version.to_s.split(".").map(&:to_i) + [0, 0, 0])
                        .first(3)
  case part
  when "major" then "#{major + 1}.0.0"
  when "minor" then "#{major}.#{minor + 1}.0"
  else "#{major}.#{minor}.#{patch + 1}"
  end
end

def version_above?(version, other)
  Gem::Version.new(version) > Gem::Version.new(other)
end

platform :ios do
  desc "Install App Store signing files from the match repo"
  desc "Pass readonly:false once to create them on the Apple Developer portal"
  desc "Pass force:true with it to remake the profile, e.g. after turning on"
  desc "a capability such as Associated Domains for the app ID"
  lane :certificates do |options|
    match(
      api_key: asc_api_key,
      readonly: options[:readonly].to_s != "false",
      force: options[:force].to_s == "true",
    )
  end

  desc "Print the version the next release uses; see release_version"
  desc "Pass bump:minor or bump:major for a feature or major release"
  lane :version do |options|
    version = release_version(api_key: asc_api_key, bump: options[:bump])

    # Hands the version to the deploy jobs of the release workflow.
    output = ENV["GITHUB_OUTPUT"]
    File.write(output, "app_version=#{version}\n", mode: "a") if output
    write_ci_summary("### Version\nThis release is version **#{version}**.")
  end

  desc "Build a signed IPA and upload it to TestFlight"
  desc "Uses APP_VERSION when set (CI), otherwise picks the version itself"
  desc "Pass skip_upload:true to build and sign without uploading"
  lane :beta do |options|
    # On CI, create a temporary keychain so match can install the
    # certificate without a password prompt.
    setup_ci if is_ci

    api_key = asc_api_key
    version = ENV["APP_VERSION"].to_s
    version = release_version(api_key: api_key) if version.empty?
    match(api_key: api_key, readonly: true)
    build_number = next_build_number(api_key: api_key)

    # Release builds sign manually with the match profile; Debug keeps
    # Xcode's automatic signing for local development.
    update_code_signing_settings(
      path: XCODE_PROJECT,
      targets: ["Runner"],
      build_configurations: ["Release"],
      use_automatic_signing: false,
      team_id: CredentialsManager::AppfileConfig.try_fetch_value(:team_id),
      code_sign_identity: "Apple Distribution",
      profile_name: PROFILE_NAME,
    )

    FileUtils.rm_rf(IPA_DIR)
    Dir.chdir(PROJECT_ROOT) do
      sh(
        "flutter", "build", "ipa", "--release",
        "--build-name=#{version}",
        "--build-number=#{build_number}",
        "--export-options-plist=#{EXPORT_OPTIONS}",
      )
    end

    ipa_path = Dir[File.join(IPA_DIR, "*.ipa")].first
    UI.user_error!("No IPA found in #{IPA_DIR}") unless ipa_path

    if options[:skip_upload].to_s == "true"
      UI.success("Built #{ipa_path}, skipping TestFlight upload")
      next
    end

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
    )

    write_ci_summary(
      "### iOS\nUploaded version **#{version}** build **#{build_number}** " \
      "to **TestFlight**. " \
      "Apple processes it before testers can install it (usually " \
      "5–30 minutes).",
    )
  end

  # App Store Connect API key, used instead of an Apple ID login (no 2FA).
  # Locally ASC_KEY_PATH points to the .p8 file; CI passes its content
  # base64-encoded in ASC_KEY_CONTENT_BASE64.
  private_lane :asc_api_key do
    key_path = ENV["ASC_KEY_PATH"]
    app_store_connect_api_key(
      key_id: required_env("ASC_KEY_ID"),
      issuer_id: required_env("ASC_ISSUER_ID"),
      key_filepath: key_path,
      key_content: key_path ? nil : required_env("ASC_KEY_CONTENT_BASE64"),
      is_key_content_base64: key_path.nil?,
    )
  end

  # Picks the next release's version from App Store Connect, so pubspec.yaml
  # never needs a manual bump. A version stays open for more builds until
  # Apple approves it (see CLOSED_VERSION_STATES).
  #   auto (default): keep the newest TestFlight version while it is still
  #     open, so fixes go out as new builds of it; otherwise bump the patch
  #     of the last closed version.
  #   minor / major: bump that part of the last closed version.
  private_lane :release_version do |options|
    bump = (options[:bump] || "auto").to_s
    unless BUMPS.include?(bump)
      UI.user_error!("Unknown bump '#{bump}', use one of #{BUMPS.join(', ')}")
    end

    closed = last_closed_version(api_key: options[:api_key])
    latest_testflight_build_number(
      api_key: options[:api_key],
      initial_build_number: 0,
    )
    testflight = lane_context[SharedValues::LATEST_TESTFLIGHT_VERSION]
    open = testflight if testflight && version_above?(testflight, closed)

    version = if bump == "auto"
                open || bump_version(closed, "patch")
              else
                bump_version(closed, bump)
              end

    # A lower version than an open one would be a step backwards for
    # testers; finish or abandon the open version first.
    if open && version_above?(open, version)
      UI.user_error!(
        "TestFlight already has open version #{open}, above #{version}. " \
        "Use bump auto to keep building #{open}.",
      )
    end

    UI.success(
      "Version #{version} (bump: #{bump}, last approved: #{closed}, " \
      "open in TestFlight: #{open || 'none'})",
    )
    version
  end

  # Highest App Store version Apple has approved or released.
  private_lane :last_closed_version do |options|
    Spaceship::ConnectAPI.token =
      Spaceship::ConnectAPI::Token.from(hash: options[:api_key])
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found in App Store Connect") unless app

    approved = app.get_app_store_versions.select do |v|
      CLOSED_VERSION_STATES.include?(v.app_version_state)
    end
    closed = approved.map(&:version_string).max_by { |v| Gem::Version.new(v) }
    UI.user_error!("No approved App Store version found") unless closed
    closed
  end

  # Highest build number from TestFlight and pubspec.yaml, plus one.
  # Querying TestFlight avoids clashes with builds uploaded from Xcode.
  private_lane :next_build_number do |options|
    testflight_number = latest_testflight_build_number(
      api_key: options[:api_key],
      initial_build_number: 0,
    ).to_i

    pubspec = File.read(File.join(PROJECT_ROOT, "pubspec.yaml"))
    pubspec_number = pubspec[/^version:\s*[^+\s]+\+(\d+)/, 1].to_i

    next_number = [testflight_number, pubspec_number].max + 1
    UI.message("Next build number: #{next_number}")
    next_number
  end
end
